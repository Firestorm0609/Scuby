DATABASE_URL=postgresql://user:password@localhost:5432/pumpbot

PUMPPORTAL_WS_URL=wss://pumpportal.fun/api/data
# only needed once you subscribe to trade streams at scale (metered)
PUMPPORTAL_API_KEY=

HELIUS_API_KEY=

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

LABEL_WINDOW_SECONDS=86400
ACTIVE_TRACK_SECONDS=14400
MAX_ACTIVE_SUBSCRIPTIONS=300

# --- Training ---
MIN_LABELED_TOKENS_TO_TRAIN=5000
RETRAIN_INTERVAL_HOURS=12
RETRAIN_ON_NEW_LABELS=1000
RECENCY_HALF_LIFE_DAYS=30
MODEL_DIR=models

# --- Free polling fallback (no PumpPortal API key / SOL needed) ---
PUMP_FRONTEND_API_BASE=https://frontend-api.pump.fun
POLL_INTERVAL_SECONDS=15
POLL_CONCURRENCY=10
POLL_TRACK_SECONDS=14400
