# ═══════════════════════════════════════════════════════════════════════════════
# Scuby OG Finder — Environment Variables
# Copy this to .env and fill in your keys.
# ═══════════════════════════════════════════════════════════════════════════════

# ─── Telegram ─────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
OWNER_ID=your_telegram_user_id_here

# ─── AI Providers (at least one required for full functionality) ──────────────
# Priority: Groq > Cerebras > Gemini > OpenRouter > Local
# Get free keys at:
#   Groq:      https://console.groq.com        (30 RPM, 1K req/day free)
#   Cerebras:  https://cloud.cerebras.ai        (1M tokens/day free)
#   Gemini:    https://ai.google.dev             (1,500 req/day free)
#   OpenRouter: https://openrouter.ai            (50 req/day free, 20+ models)

GROQ_API_KEY=
CEREBRAS_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Override auto-detection (optional): groq|cerebras|gemini|openrouter|local
# AI_PROVIDER=groq

# ─── Solana RPC (optional, improves rate limits) ─────────────────────────────
# Without this, uses public Solana RPC (rate-limited)
# HELIUS_RPC_URL=https://your-helius-rpc-url
